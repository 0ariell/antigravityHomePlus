generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String           @id @default(uuid())
  email                  String           @unique
  password               String?
  role                   UserRole
  googleId               String?          @unique
  firstName              String?
  lastName               String?
  phone                  String?
  avatarUrl              String?
  bio                    String?
  zone                   String?
  trades                 String[]
  certifications         String[]
  portfolioUrls          String[]
  address                String?
  avgRating              Float            @default(0)
  totalReviews           Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  isOnline               Boolean          @default(false)
  latitude               Float?
  longitude              Float?
  aptitudes              String[]
  isTeam                 Boolean          @default(false)
  languages              String[]
  teamSize               Int              @default(1)
  tools                  String[]
  vehicles               String[]
  yearsExperience        Int              @default(0)
  bookingsAsClient       Booking[]        @relation("ClientBookings")
  bookingsAsProvider     Booking[]        @relation("ProviderBookings")
  messages               Message[]
  notifications          Notification[]
  payments               Payment[]
  quotes                 Quote[]
  reviewsGiven           Review[]         @relation("ReviewAuthor")
  reviewsReceived        Review[]         @relation("ReviewSubject")
  serviceRequests        ServiceRequest[]
  directRequestsReceived ServiceRequest[] @relation("DirectRequests")
  services               Service[]

  @@map("users")
}

model Service {
  id           String    @id @default(uuid())
  providerId   String
  title        String
  description  String
  category     String
  zone         String
  priceBase    Float?
  priceUnit    String?
  images       String[]
  isActive     Boolean   @default(true)
  avgRating    Float     @default(0)
  totalReviews Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  provider     User      @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([zone])
  @@index([providerId])
  @@map("services")
}

model ServiceRequest {
  id               String        @id @default(uuid())
  clientId         String
  category         String
  title            String
  description      String
  images           String[]
  zone             String
  preferredDate    DateTime?
  status           RequestStatus @default(OPEN)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  latitude         Float?
  longitude        Float?
  targetProviderId String?
  diagnosis        Json?
  extraInfo        String?
  quotes           Quote[]
  client           User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetProvider   User?         @relation("DirectRequests", fields: [targetProviderId], references: [id])

  @@index([category])
  @@index([zone])
  @@index([status])
  @@index([targetProviderId])
  @@map("service_requests")
}

model Quote {
  id            String         @id @default(uuid())
  requestId     String
  providerId    String
  price         Float
  description   String?
  status        QuoteStatus    @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  estimatedDate DateTime?
  isAsap        Boolean        @default(false)
  provider      User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

model Booking {
  id            String        @id @default(uuid())
  clientId      String
  providerId    String
  serviceId     String?
  status        BookingStatus @default(PENDING)
  description   String
  images        String[]
  preferredDate DateTime?
  address       String
  latitude      Float?
  longitude     Float?
  notes         String?
  quotedPrice   Float?
  finalPrice    Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  acceptedAt    DateTime?
  completedAt   DateTime?
  startedAt     DateTime?
  diagnosis     Json?
  extraInfo     String?
  client        User          @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  provider      User          @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  service       Service?      @relation(fields: [serviceId], references: [id])
  conversation  Conversation?
  payment       Payment?
  review        Review?

  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@map("bookings")
}

model Conversation {
  id        String    @id @default(uuid())
  bookingId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachments    String[]
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  authorId   String
  providerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider   User     @relation("ReviewSubject", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("reviews")
}

model Payment {
  id           String        @id @default(uuid())
  bookingId    String        @unique
  providerId   String
  amount       Float
  currency     String        @default("ARS")
  status       PaymentStatus @default(PENDING)
  providerRef  String?
  providerData Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  completedAt  DateTime?
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider     User          @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@map("payments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

enum UserRole {
  CLIENT
  PROVIDER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  NEW_MESSAGE
  NEW_REVIEW
  PAYMENT_RECEIVED
}

enum RequestStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}
